*.suo
*.user
CMakeSettings.json
.idea/

# Game files - DO NOT COMMIT
*.iso
*.gcm
*.rvz
*.wia
*.wbfs
*.ciso
*.nfs
*.gcz
*.tgc

# Generated recompiled source
# Generated code -- except recomp_common.h, which is NOT generated for this
# project. It binds every generated function to ww::g_mem / ww::g_func_table;
# regenerating over it compiles cleanly and then crashes at run time. Git will
# not descend into an ignored directory, so this must be dir/* to allow the
# negation below.
recompiled/*
!recompiled/recomp_common.h

# Extracted assets
assets/extracted/

# Game files - additional
main.dol
main.elf

# Ghidra project + per-machine analysis outputs
tools/ghidra/project/
tools/ghidra/out/
tools/ghidra/run.log
tools/ghidra/run.log.err

# Diagnostic captures and screenshots
dolphin_*.bin
dolphin_*.json
dolphin_*.txt
*.png

# Local Claude settings
.claude/settings.local.json

# OS
Thumbs.db
.DS_Store
desktop.ini

# Dolphin MEM1 snapshots (24MB each, tools/dolphin_dump.py --snapshot)
*snapshot*.bin

# IDA database (35MB, regenerable from main.elf)
*.i64

# ...but README assets are part of the repo
!assets/screenshot-*.png

# ...but this one is not generated for this project: it binds the generated
# code to ww's runtime (ww::g_mem / ww::g_func_table). Losing it compiles
# fine and then crashes.
!recompiled/recomp_common.h
